    {"id":"parallax-checker","from":{"nodeId":"parallax","portId":"uv"},"to":{"nodeId":"checker","portId":"uv"}},
    {"id":"checker-surface","from":{"nodeId":"checker","portId":"color"},"to":{"nodeId":"surface","portId":"albedo"}},
    {"id":"surface-output","from":{"nodeId":"surface","portId":"surface"},"to":{"nodeId":"output","portId":"surface"}}
  ],"parameters":[],"resources":[{"id":"heightMap","kind":"texture2D","uri":"builtin://white"}]
