{
  "format":"nxsg","schemaVersion":1,"graphId":"parallax-tiles-example",
  "nodes":[
    {"id":"uv","operation":"core.uv0","version":1,"properties":{}},
    {"id":"parallax","operation":"core.parallaxOcclusion","version":1,"properties":{"resourceId":"heightMap","strength":0.05,"steps":16}},
    {"id":"checker","operation":"core.checker","version":1,"properties":{"dimensions":2,"scale":8,"speed":0}},
    {"id":"surface","operation":"core.toonSurface","version":1,"properties":{}},
    {"id":"output","operation":"core.output","version":1,"properties":{}}
