{
  "format": "nxsg",
  "schemaVersion": 1,
  "graphId": "neon-wireframe-example",
  "nodes": [
    {
      "id": "wire",
      "operation": "core.wireframe",
      "version": 1,
      "properties": {
        "width": 1.5,
        "softness": 1
      }
    },
    {
      "id": "color",
      "operation": "core.constant",
      "version": 1,
      "properties": {
        "valueType": "color",
        "value": [
          0.05,
          0.7,
          1,
          1
        ]
      }
    },
    {
      "id": "tint",
      "operation": "core.multiply",
      "version": 1,
      "properties": {}
    },
    {
      "id": "base",
      "operation": "core.constant",
      "version": 1,
      "properties": {
        "valueType": "color",
        "value": [
          0.005,
          0.01,
          0.025,
          1
        ]
      }
    },
    {
      "id": "surface",
      "operation": "core.unlitSurface",
      "version": 1,
      "properties": {}
    },
    {
      "id": "output",
      "operation": "core.output",
      "version": 1,
      "properties": {}
    }
  ],
  "connections": [
    {
      "id": "wire-tint-a",
      "from": {
        "nodeId": "wire",
        "portId": "value"
      },
      "to": {
        "nodeId": "tint",
        "portId": "a"
      }
    },
    {
      "id": "color-tint-b",
      "from": {
        "nodeId": "color",
        "portId": "value"
      },
      "to": {
        "nodeId": "tint",
        "portId": "b"
      }
    },
    {
      "id": "base-surface-albedo",
      "from": {
        "nodeId": "base",
        "portId": "value"
      },
      "to": {
        "nodeId": "surface",
        "portId": "albedo"
      }
    },
    {
      "id": "tint-surface-emission",
      "from": {
        "nodeId": "tint",
        "portId": "value"
      },
      "to": {
        "nodeId": "surface",
        "portId": "emission"
      }
    },
    {
      "id": "surface-output-surface",
      "from": {
        "nodeId": "surface",
        "portId": "surface"
      },
      "to": {
        "nodeId": "output",
        "portId": "surface"
      }
    }
  ],
  "parameters": [],
  "resources": [],
  "layout": {
    "nodes": {
      "wire": {
        "x": 20,
        "y": 40
      },
      "color": {
        "x": 20,
        "y": 200
      },
      "tint": {
        "x": 250,
        "y": 60
      },
      "base": {
        "x": 250,
        "y": 240
      },
      "surface": {
        "x": 480,
        "y": 80
      },
      "output": {
        "x": 740,
        "y": 80
      }
    }
  }
}
