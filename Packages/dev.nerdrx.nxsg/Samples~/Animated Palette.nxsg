{
  "format": "nxsg",
  "schemaVersion": 1,
  "graphId": "animated-palette-example",
  "nodes": [
    {
      "id": "time",
      "operation": "core.time",
      "version": 1,
      "properties": {
        "speed": 0.35,
        "offset": 0
      }
    },
    {
      "id": "noise",
      "operation": "core.noise",
      "version": 1,
      "properties": {
        "scale": 5,
        "speed": 1
      }
    },
    {
      "id": "warm",
      "operation": "core.constant",
      "version": 1,
      "properties": {
        "valueType": "color",
        "value": [
          1,
          0.08,
          0.02,
          1
        ]
      }
    },
    {
      "id": "cool",
      "operation": "core.constant",
      "version": 1,
      "properties": {
        "valueType": "color",
        "value": [
          0.03,
          0.35,
          1,
          1
        ]
      }
    },
    {
      "id": "mix",
      "operation": "core.mix",
      "version": 1,
      "properties": {
        "factor": 0.5
      }
    },
    {
      "id": "glow",
      "operation": "core.emission",
      "version": 1,
      "properties": {
        "strength": 0.3
      }
    },
    {
      "id": "toon",
      "operation": "core.toonSurface",
      "version": 1,
      "properties": {}
    },
    {
      "id": "output",
      "operation": "core.output",
      "version": 1,
      "properties": {}
    }
  ],
  "connections": [
    {
      "id": "time-value-noise-time",
      "from": {
        "nodeId": "time",
        "portId": "value"
      },
      "to": {
        "nodeId": "noise",
        "portId": "time"
      }
    },
    {
      "id": "noise-value-mix-factor",
      "from": {
        "nodeId": "noise",
        "portId": "value"
      },
      "to": {
        "nodeId": "mix",
        "portId": "factor"
      }
    },
    {
      "id": "warm-value-mix-a",
      "from": {
        "nodeId": "warm",
        "portId": "value"
      },
      "to": {
        "nodeId": "mix",
        "portId": "a"
      }
    },
    {
      "id": "cool-value-mix-b",
      "from": {
        "nodeId": "cool",
        "portId": "value"
      },
      "to": {
        "nodeId": "mix",
        "portId": "b"
      }
    },
    {
      "id": "mix-value-toon-albedo",
      "from": {
        "nodeId": "mix",
        "portId": "value"
      },
      "to": {
        "nodeId": "toon",
        "portId": "albedo"
      }
    },
    {
      "id": "mix-value-glow-color",
      "from": {
        "nodeId": "mix",
        "portId": "value"
      },
      "to": {
        "nodeId": "glow",
        "portId": "color"
      }
    },
    {
      "id": "glow-color-toon-emission",
      "from": {
        "nodeId": "glow",
        "portId": "color"
      },
      "to": {
        "nodeId": "toon",
        "portId": "emission"
      }
    },
    {
      "id": "toon-surface-output-surface",
      "from": {
        "nodeId": "toon",
        "portId": "surface"
      },
      "to": {
        "nodeId": "output",
        "portId": "surface"
      }
    }
  ],
  "parameters": [],
