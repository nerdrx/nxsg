/* Shared spacing for editor chrome; canvas nodes keep their category colors. */
.nxsg-window { font-size: 12px; }
.nxsg-window > .unity-toolbar { flex-shrink: 0; padding-top: 2px; padding-bottom: 2px; }
.nxsg-window .unity-toolbar-button, .nxsg-window .unity-toolbar-menu, .nxsg-window .unity-toolbar-toggle { min-height: 26px; padding-left: 7px; padding-right: 7px; }
#nxsg-sidebar .unity-button { min-height: 25px; white-space: normal; }
#nxsg-sidebar .unity-base-field { min-height: 25px; margin-top: 3px; margin-bottom: 3px; }
#nxsg-sidebar .unity-base-field__label { min-width: 0; width: 44%; flex-shrink: 0; white-space: normal; }
#nxsg-sidebar .unity-base-text-field__input, #nxsg-sidebar .unity-base-popup-field__input { min-width: 0; }
#nxsg-sidebar .unity-toolbar-search-field { margin-top: 6px; margin-bottom: 8px; }
#nxsg-sidebar .nxsg-tab { white-space: nowrap; min-width: 0; flex-grow: 1; -unity-text-align: middle-center; }
#nxsg-sidebar .nxsg-tab-selected { background-color: rgb(58, 68, 80); color: white; border-bottom-width: 2px; border-bottom-color: rgb(135, 182, 238); }
#nxsg-connected-menu { border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(100,100,100); border-right-color: rgb(100,100,100); border-top-color: rgb(100,100,100); border-bottom-color: rgb(100,100,100); }
#nxsg-connected-menu .unity-button { min-height: 26px; white-space: normal; flex-shrink: 0; }

/* Graphite chrome with NX violet reserved for actions and focus. */
.nxsg-window { color: rgb(229,231,233); }
.nxsg-window .unity-toolbar { background-color: rgb(36,39,43); border-bottom-color: rgb(59,63,69); }
.nxsg-window > .unity-toolbar { padding-left: 6px; padding-right: 6px; padding-top: 5px; padding-bottom: 5px; }
.nxsg-window .unity-toolbar-button, .nxsg-window .unity-toolbar-menu, .nxsg-window .unity-toolbar-toggle {
    border-width: 0; border-radius: 3px; margin-left: 2px; margin-right: 2px; color: rgb(220,224,230); background-color: rgb(44,48,53);
}
.nxsg-window .unity-button { border-radius: 3px; background-color: rgb(48,52,58); border-color: rgb(66,71,79); color: rgb(229,231,233); }
.nxsg-window .unity-button:hover, .nxsg-window .unity-toolbar-menu:hover, .nxsg-window .unity-toolbar-toggle:hover { background-color: rgb(63,68,76); }
.nxsg-window .unity-button:focus { border-color: rgb(181,141,255); }
.nxsg-window .unity-toolbar-toggle:checked { background-color: rgb(66,49,92); color: rgb(231,216,255); }
#nxsg-build { -unity-text-align: middle-center; padding-top: 0; padding-bottom: 0; height: 28px; background-color: rgb(119,0,255); color: white; padding-left: 14px; padding-right: 14px; }
#nxsg-build:hover { background-color: rgb(142,51,255); }
#nxsg-identity { background-color: rgb(39,42,46); color: rgb(215,219,226); }
#nxsg-scene-status { background-color: rgb(39,42,46); font-size: 11px; }
#nxsg-status { background-color: rgb(37,40,44); color: rgb(177,184,194); border-top-width: 1px; border-top-color: rgb(59,63,69); font-size: 11px; }
#nxsg-sidebar { border-left-width: 1px; border-left-color: rgb(62,67,74); }
#nxsg-sidebar .nxsg-tab { background-color: rgba(0,0,0,0); min-height: 32px; border-radius: 0; color: rgb(175,183,195); }
#nxsg-sidebar .nxsg-tab-selected { color: white; border-bottom-width: 2px; border-bottom-color: rgb(169,109,255); }
#nxsg-sidebar .unity-base-field__label { color: rgb(206,212,221); }
#nxsg-sidebar .unity-base-text-field__input, #nxsg-sidebar .unity-base-popup-field__input {
    background-color: rgb(30,33,37); color: rgb(229,231,233); border-width: 1px; border-color: rgb(62,68,76); border-radius: 3px; padding-left: 6px;
}
#nxsg-sidebar .unity-base-text-field__input:focus { border-color: rgb(169,109,255); }
#nxsg-sidebar .unity-base-slider__tracker { background-color: rgb(22,24,28); }
#nxsg-sidebar .unity-base-slider__dragger { background-color: rgb(183,152,231); border-radius: 2px; }
#nxsg-node-heading { font-size: 15px; color: rgb(243,244,246); margin-bottom: 7px; }
#nxsg-node-description { color: rgb(176,184,196); }
#nxsg-material-preview { border-radius: 3px; margin-top: 6px; margin-bottom: 8px; }
#nxsg-sidebar .nxsg-section { color: rgb(177,184,194); font-size: 11px; -unity-font-style: bold; margin-top: 14px; padding-top: 12px; margin-bottom: 8px; border-top-width: 1px; border-top-color: rgb(62,67,74); }
#nxsg-connected-menu { border-radius: 4px; border-color: rgb(103,86,130); }

.nxsg-brand { color: rgb(190,146,255); -unity-font-style: bold; -unity-text-align: middle-center; padding-left: 7px; padding-right: 12px; }
#nxsg-sidebar .nxsg-tab-selected { background-color: rgba(0,0,0,0); }
#nxsg-sidebar .unity-scroller .unity-base-slider__dragger { background-color: rgb(91,97,109); }

/* Native toolbar styles keep top padding when their height changes. Reset it
   for all button families so labels share a centered baseline. */
.nxsg-window .unity-button, .nxsg-window .unity-toolbar-button,
.nxsg-window .unity-toolbar-menu, .nxsg-window .unity-toolbar-toggle {
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-bottom: 0;
    justify-content: center;
    align-items: center;
}
.nxsg-window .unity-toolbar-menu .unity-toolbar-menu__text,
.nxsg-window .unity-toolbar-toggle .unity-toggle__text {
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-bottom: 0;
    align-self: center;
}
